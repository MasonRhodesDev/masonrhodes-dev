---
interface Props { name: string; url: string; blurb: string; tags: string[]; }
const { name, url, blurb, tags } = Astro.props;
---
<li class="card">
  <h3><a href={url} rel="noopener">{name}</a></h3>
  <p class="muted">{blurb}</p>
  <ul class="tags" aria-label="Technologies">
    {tags.map((t) => <li>{t}</li>)}
  </ul>
</li>
<style>
  .card {
    list-style: none; background: var(--color-surface); border: 1px solid var(--color-outline);
    border-radius: var(--radius-md); padding: var(--space-4) var(--space-6);
    transition: border-color .15s ease, transform .15s ease;
  }
  .card:hover { border-color: var(--color-accent); transform: translateY(-1px); }
  h3 { font-size: var(--text-lg); margin-bottom: var(--space-1); }
  h3 a { text-decoration: none; }
  h3 a::after { content: ""; position: absolute; inset: 0; }
  .card { position: relative; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: 0; margin: var(--space-3) 0 0; }
  .tags li {
    list-style: none; font: var(--text-sm) var(--font-mono); background: var(--color-surface-raised);
    padding: 0 var(--space-3); border-radius: var(--radius-pill); color: var(--color-text-muted);
  }
</style>
