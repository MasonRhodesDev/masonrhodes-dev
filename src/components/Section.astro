---
interface Props { title: string; label?: string; id?: string; }
const { title, label, id } = Astro.props;
---
<section class="section" id={id}>
  <header>
    {label && <p class="label">{label}</p>}
    <h2>{title}</h2>
  </header>
  <div class="body"><slot /></div>
</section>
<style>
  .section { border-top: var(--rule) solid var(--color-ink); padding-block: var(--space-12) var(--space-16); }
  header { display: grid; gap: var(--space-2); margin-bottom: var(--space-8); }
  .body { display: grid; gap: var(--space-6); }
</style>
