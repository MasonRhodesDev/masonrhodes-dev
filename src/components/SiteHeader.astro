---
import ThemeToggle from './ThemeToggle.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { label: 'Projects', href: `${base}/projects/` },
  { label: 'About', href: `${base}/about/` },
];
---
<header class="site-header no-print">
  <div class="container bar">
    <a class="brand" href={`${base}/`}>{site.name}</a>
    <nav aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <ThemeToggle />
    </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--color-outline); }
  .bar { display: flex; align-items: center; justify-content: space-between; padding-block: var(--space-3); }
  .brand { font-weight: 700; color: var(--color-text); text-decoration: none; }
  nav { display: flex; align-items: center; gap: var(--space-6); }
  nav a { color: var(--color-text-muted); text-decoration: none; }
  nav a:hover { color: var(--color-accent); }
</style>
