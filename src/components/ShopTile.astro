---
interface Props { title: string; text: string; }
const { title, text } = Astro.props;
---
<li class="tile">
  <div class="photo" role="img" aria-label={`Photo placeholder for ${title}`}></div>
  <h3>{title}</h3>
  <p class="muted">{text}</p>
</li>
<style>
  .tile { list-style: none; display: grid; gap: var(--space-2); align-content: start; }
  .photo {
    aspect-ratio: 4 / 3; border: 1px solid var(--color-ink);
    background: repeating-linear-gradient(135deg, var(--color-surface) 0 10px, var(--color-outline) 10px 11px);
  }
</style>
