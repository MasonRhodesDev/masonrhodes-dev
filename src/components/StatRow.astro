---
interface Props { stats: { value: string; label: string }[]; }
const { stats } = Astro.props;
---
<dl class="stats">
  {stats.map((s) => (
    <div><dd>{s.value}</dd><dt class="label">{s.label}</dt></div>
  ))}
</dl>
<style>
  .stats { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); border: 1px solid var(--color-ink); }
  .stats > div { padding: var(--space-4); display: grid; gap: var(--space-2); }
  .stats > div + div { border-left: 1px solid var(--color-outline); }
  dd { margin: 0; font: 900 2.6rem/1 var(--font-display); color: var(--color-accent); }
  dt { order: 2; }
  @media (max-width: 34rem) { .stats > div:nth-child(odd) { border-left: 0; } .stats > div:nth-child(n+3) { border-top: 1px solid var(--color-outline); } }
</style>
