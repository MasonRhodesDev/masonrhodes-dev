---
interface Props { items: { year: string; text: string }[]; }
const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((i) => (
    <li><span class="year">{i.year}</span><p>{i.text}</p></li>
  ))}
</ol>
<style>
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; }
  li { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-3); border-top: 1px solid var(--color-outline); }
  .year { font: 900 1.6rem/1 var(--font-display); color: var(--color-accent); }
</style>
