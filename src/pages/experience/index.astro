---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import experience from '../../data/experience.json';
import site from '../../data/site.json';
---
<Base title="Experience" noindex description={`${experience.role} at ${experience.company}, since ${experience.since}.`}>
  <div class="page">
    <p class="label">{experience.company} / since {experience.since}</p>
    <h1>{experience.role}</h1>
    <p class="prose muted">{experience.summary}</p>

    <h2>What I own</h2>
    <ul class="impact">
      {experience.impact.map((i) => (
        <li><h3>{i.title}</h3><p class="muted">{i.text}</p></li>
      ))}
    </ul>

    <h2>Where I have worked</h2>
    <ol class="jobs">
      {experience.jobs.map((j) => (
        <li>
          <div class="head">
            <h3>{j.company}</h3>
            <p class="label">{j.dates} / {j.where}</p>
          </div>
          <p><strong>{j.role}</strong></p>
          {j.note && <p class="muted">{j.note}</p>}
          <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
        </li>
      ))}
    </ol>

    <h2>Career, newest first</h2>
    <Timeline items={experience.timeline} />

    <p class="prose">Want the full resume? <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </div>
</Base>
<style>
  .page { display: grid; gap: var(--space-8); padding-block: var(--space-12) var(--space-16); }
  h1 { font-size: clamp(2.4rem, 1rem + 6vw, 4.5rem); }
  .prose { max-width: var(--prose); }
  .impact { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-6); }
  .impact h3 { margin-bottom: var(--space-2); }
  .jobs { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-8); }
  .jobs > li { border-top: 1px solid var(--color-outline); padding-top: var(--space-4); display: grid; gap: var(--space-2); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2); }
  .jobs ul { margin: var(--space-2) 0 0; padding-left: 1.1em; display: grid; gap: var(--space-1); color: var(--color-text-muted); }
</style>
