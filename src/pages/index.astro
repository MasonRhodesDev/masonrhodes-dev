---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import site from '../data/site.json';
import projects from '../data/projects.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = projects.filter((p) => p.featured);
---
<Base>
  <section class="hero stack">
    <p class="muted role">{site.role}</p>
    <h1>{site.name}</h1>
    <p class="lead muted">{site.tagline}</p>
    <ul class="links">
      {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </section>

  <section class="stack">
    <h2>Featured projects</h2>
    <ProjectList items={featured} />
    <p><a href={`${base}/projects/`}>All projects</a></p>
  </section>
</Base>
<style>
  .hero { margin-bottom: var(--space-16); }
  h1 { font-size: var(--text-xl); }
  .role { font: var(--text-sm) var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .lead { font-size: var(--text-lg); max-width: 36rem; }
  .links { display: flex; gap: var(--space-6); list-style: none; padding: 0; margin: 0; }
  h2 { font-size: var(--text-lg); }
</style>
